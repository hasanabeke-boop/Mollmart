generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  buyer
  seller
  admin
}

enum UserStatus {
  active
  blocked
  suspended
}

enum WorkspaceMode {
  buyer
  seller
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum RequestStatus {
  draft
  published
  has_offers
  in_negotiation
  accepted
  closed
  cancelled
}

enum RequestStatusHistoryAction {
  created
  updated
  published
  moved_to_has_offers
  moved_to_negotiation
  accepted
  closed
  cancelled
}

enum OfferStatus {
  submitted
  updated
  withdrawn
  accepted
  rejected
  expired
}

enum OfferStatusHistoryAction {
  created
  updated
  withdrawn
  accepted
  rejected
  expired
}

enum AuctionSessionStatus {
  gathering
  scheduled
  live
  ended
  cancelled
  no_winner
}

enum AuctionParticipantStatus {
  registered
  active
  withdrawn
  winner
  eliminated
}

enum ConversationStatus {
  active
  closed
}

enum MessageType {
  text
  system
}

enum PriceProposalStatus {
  pending
  accepted
  declined
  superseded
}

enum SenderRole {
  buyer
  seller
  admin
}

enum ModerationTargetType {
  request
  offer
  user
}

enum ModerationCaseStatus {
  open
  in_review
  resolved
  dismissed
}

enum ModerationActionType {
  note
  hide_content
  unhide_content
  block_user
  unblock_user
  resolve_case
}

enum ContentFlagStatus {
  active
  hidden
  cleared
}

enum NotificationType {
  request_published
  offer_created
  offer_updated
  offer_withdrawn
  offer_accepted
  offer_rejected
  chat_message_created
  user_blocked
  moderation_case_created
  shop_order_placed
  shop_order_status_changed
  request_deal_paid
  request_deal_status_changed
}

enum NotificationReferenceType {
  request
  offer
  conversation
  user
  moderation_case
  catalog_order
  request_deal_order
}

enum CatalogProductStatus {
  draft
  published
  archived
}

enum CatalogOrderStatus {
  processing
  shipped
  delivered
  cancelled
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expiresAt         DateTime
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model User {
  id                     String                   @id @default(cuid())
  name                   String
  email                  String?                  @unique
  password               String
  role                   UserRole                 @default(buyer)
  canBuy                 Boolean                  @default(true)
  canSell                Boolean                  @default(false)
  activeWorkspaceMode    WorkspaceMode            @default(buyer)
  languagePreference     String                   @default("en") @db.VarChar(8)
  recommendationsOnboardingCompletedAt DateTime?
  recommendationsOnboardingSkippedAt   DateTime?
  notificationPreferencesJson          Json?
  status                 UserStatus               @default(active)
  emailVerified          DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  lastLoginAt            DateTime?
  accounts               Account[]
  refreshTokens          RefreshToken[]
  resetToken             ResetToken[]
  emailVerificationToken EmailVerificationToken[]
  passwordChangeToken    PasswordChangeToken[]
  profile                UserProfile?
  requests               Request[]          @relation("BuyerRequests")
  offers                 Offer[]            @relation("SellerOffers")
  buyerConversations     Conversation[]     @relation("BuyerConversations")
  sellerConversations    Conversation[]     @relation("SellerConversations")
  sentMessages           Message[]          @relation("SentMessages")
  messageReadStates      MessageReadState[]
  notifications          Notification[]
  catalogProducts        CatalogProduct[] @relation("SellerCatalogProducts")
  cartItems              CartItem[]
  catalogOrdersAsBuyer   CatalogOrder[]   @relation("BuyerCatalogOrders")
  catalogOrdersAsSeller  CatalogOrder[]   @relation("SellerCatalogOrders")
  walletBalance          Decimal          @default(0) @db.Decimal(14, 2)
  priceProposals         PriceProposal[]  @relation("PriceProposalProposer")
  requestDealsAsBuyer    RequestDealOrder[] @relation("RequestDealBuyer")
  requestDealsAsSeller   RequestDealOrder[] @relation("RequestDealSeller")
  auctionParticipants  AuctionParticipant[] @relation("SellerAuctionParticipants")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model ResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model PasswordChangeToken {
  id             String   @id @default(cuid())
  token          String   @unique
  hashedPassword String
  expiresAt      DateTime
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  createdAt      DateTime @default(now())
}

model UserProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  role          UserRole
  fullName      String
  phone         String?
  city          String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sellerProfile SellerProfile?
  buyerProfile  BuyerProfile?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role, createdAt(sort: Desc)])
}

model SellerProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  displayName         String
  description         String?            @db.Text
  businessType        String?
  website             String?
  instagramUrl        String?
  preferencesJson     Json?
  verificationStatus  VerificationStatus @default(unverified)
  ratingAverage       Decimal            @default(0) @db.Decimal(3, 2)
  completedDealsCount Int                @default(0)
  userProfile         UserProfile        @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([verificationStatus, ratingAverage(sort: Desc)])
}

model BuyerProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  displayName     String
  city            String?
  preferencesJson Json?
  userProfile     UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model Request {
  id            String                 @id @default(cuid())
  buyerId       String
  title         String
  description   String                 @db.Text
  categoryId    String
  quantity      Int                    @default(1)
  budgetMin     Decimal?               @db.Decimal(12, 2)
  budgetMax     Decimal?               @db.Decimal(12, 2)
  currency      String                 @db.VarChar(3)
  location      String?
  deadlineAt    DateTime?
  status        RequestStatus          @default(draft)
  offerCount    Int                    @default(0)
  isNegotiable  Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  publishedAt   DateTime?
  closedAt      DateTime?
  buyer         User                   @relation("BuyerRequests", fields: [buyerId], references: [id], onDelete: Cascade)
  attachments   RequestAttachment[]
  statusHistory RequestStatusHistory[]
  offers        Offer[]
  conversations Conversation[]
  dealOrders    RequestDealOrder[]
  auctionSession AuctionSession?

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([deadlineAt])
}

model RequestAttachment {
  id        String   @id @default(cuid())
  requestId String
  fileName  String
  fileUrl   String
  mimeType  String?
  createdAt DateTime @default(now())
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model RequestStatusHistory {
  id         String                     @id @default(cuid())
  requestId  String
  fromStatus RequestStatus?
  toStatus   RequestStatus
  action     RequestStatusHistoryAction
  actorId    String
  note       String?
  createdAt  DateTime                   @default(now())
  request    Request                    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt(sort: Desc)])
}

model Offer {
  id            String               @id @default(cuid())
  requestId     String
  sellerId      String
  price         Decimal              @db.Decimal(12, 2)
  currency      String               @db.VarChar(3)
  message       String               @db.Text
  deliveryDays  Int?
  warrantyInfo  String?              @db.Text
  status        OfferStatus          @default(submitted)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  acceptedAt    DateTime?
  withdrawnAt   DateTime?
  request       Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  seller        User                 @relation("SellerOffers", fields: [sellerId], references: [id], onDelete: Cascade)
  statusHistory OfferStatusHistory[]
  conversations Conversation[]

  @@index([requestId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([requestId, status])
}

model OfferStatusHistory {
  id         String                   @id @default(cuid())
  offerId    String
  fromStatus OfferStatus?
  toStatus   OfferStatus
  action     OfferStatusHistoryAction
  actorId    String
  note       String?
  createdAt  DateTime                 @default(now())
  offer      Offer                    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, createdAt(sort: Desc)])
}

model AuctionSession {
  id               String               @id @default(cuid())
  requestId        String               @unique
  status           AuctionSessionStatus @default(gathering)
  participantCount Int                  @default(0)
  scheduledAt      DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  currentRound     Int                  @default(0)
  roundEndsAt      DateTime?
  roundPausedUntil DateTime?
  leaderSellerId   String?
  leaderPrice      Decimal?             @db.Decimal(12, 2)
  winnerSellerId   String?
  winningPrice     Decimal?             @db.Decimal(12, 2)
  consecutiveNoBidRounds Int            @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  request          Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  participants     AuctionParticipant[]
  bidEvents        AuctionBidEvent[]

  @@index([status, scheduledAt])
  @@index([status, roundEndsAt])
}

model AuctionParticipant {
  id             String                   @id @default(cuid())
  sessionId      String
  sellerId       String
  startPrice     Decimal                  @db.Decimal(12, 2)
  floorPrice     Decimal                  @db.Decimal(12, 2)
  currentPrice   Decimal                  @db.Decimal(12, 2)
  currency       String                   @db.VarChar(3)
  deliveryDays   Int?
  message        String?                  @db.Text
  status         AuctionParticipantStatus @default(registered)
  inactiveRounds Int                      @default(0)
  actedThisRound Boolean                  @default(false)
  registeredAt   DateTime                 @default(now())
  withdrawnAt    DateTime?
  session        AuctionSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seller         User                     @relation("SellerAuctionParticipants", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sellerId])
  @@index([sellerId, status])
  @@index([sessionId, status])
}

model AuctionBidEvent {
  id          String         @id @default(cuid())
  sessionId   String
  sellerId    String
  roundNumber Int
  priceBefore Decimal        @db.Decimal(12, 2)
  priceAfter  Decimal        @db.Decimal(12, 2)
  eventType   String
  createdAt   DateTime       @default(now())
  session     AuctionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Desc)])
}

model Conversation {
  id               String             @id @default(cuid())
  requestId      String
  offerId        String?
  buyerId        String
  sellerId       String
  status           ConversationStatus @default(active)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lastMessageAt    DateTime?
  agreedPrice      Decimal?           @db.Decimal(12, 2)
  agreedCurrency   String?            @db.VarChar(3)
  agreedAt         DateTime?
  agreedProposalId String?
  request          Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offer            Offer?             @relation(fields: [offerId], references: [id], onDelete: SetNull)
  buyer            User               @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller           User               @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages         Message[]
  priceProposals   PriceProposal[]
  dealOrders       RequestDealOrder[]

  @@unique([requestId, buyerId, sellerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
}

model Message {
  id             String             @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     SenderRole
  body           String             @db.Text
  messageType    MessageType        @default(text)
  createdAt      DateTime           @default(now())
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  readStates     MessageReadState[]

  @@index([conversationId, createdAt(sort: Desc)])
}

model MessageReadState {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt(sort: Desc)])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryTree")
  catalogProducts CatalogProduct[]

  @@index([parentId])
  @@index([isActive, createdAt(sort: Desc)])
}

model CatalogProduct {
  id             String               @id @default(cuid())
  sellerId       String
  title          String
  description    String               @db.Text
  categoryId     String
  slug           String               @unique
  price          Decimal              @db.Decimal(12, 2)
  compareAtPrice Decimal?             @db.Decimal(12, 2)
  currency       String               @db.VarChar(3)
  imageUrl       String
  galleryUrls    Json?
  quantity       Int                  @default(0)
  status         CatalogProductStatus @default(draft)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  seller         User                 @relation("SellerCatalogProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems      CartItem[]
  orderLines     CatalogOrderLine[]

  @@index([sellerId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId, status])
}

model CartItem {
  id        String         @id @default(cuid())
  buyerId   String
  productId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  buyer     User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
  @@index([buyerId])
}

model CatalogOrder {
  id              String             @id @default(cuid())
  buyerId         String
  sellerId        String
  status          CatalogOrderStatus @default(processing)
  paymentProvider String             @default("demo")
  paymentStatus   String             @default("paid")
  currency        String             @db.VarChar(3)
  subtotal        Decimal            @db.Decimal(14, 2)
  shippingAmount  Decimal            @default(0) @db.Decimal(14, 2)
  total           Decimal            @db.Decimal(14, 2)
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?            @db.Text
  trackingNumber  String?
  carrier         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  buyer           User               @relation("BuyerCatalogOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller          User               @relation("SellerCatalogOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  lines           CatalogOrderLine[]

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model CatalogOrderLine {
  id          String         @id @default(cuid())
  orderId     String
  productId   String
  productSlug String
  title       String
  imageUrl    String
  unitPrice   Decimal        @db.Decimal(12, 2)
  currency    String         @db.VarChar(3)
  quantity    Int
  order       CatalogOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model PriceProposal {
  id             String              @id @default(cuid())
  conversationId String
  proposerId     String
  amount         Decimal             @db.Decimal(12, 2)
  currency       String              @db.VarChar(3)
  status         PriceProposalStatus @default(pending)
  createdAt      DateTime            @default(now())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposer       User                @relation("PriceProposalProposer", fields: [proposerId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([proposerId])
}

model RequestDealOrder {
  id               String             @id @default(cuid())
  conversationId String             @unique
  requestId       String
  buyerId         String
  sellerId        String
  title           String
  amount          Decimal            @db.Decimal(14, 2)
  currency        String             @db.VarChar(3)
  status          CatalogOrderStatus @default(processing)
  paymentProvider String             @default("demo")
  paymentStatus   String             @default("paid")
  trackingNumber  String?
  carrier         String?
  paidAt          DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  conversation    Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  request         Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  buyer           User               @relation("RequestDealBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller          User               @relation("RequestDealSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model ModerationCase {
  id             String               @id @default(cuid())
  targetType     ModerationTargetType
  targetId       String
  reason         String               @db.Text
  status         ModerationCaseStatus @default(open)
  createdBy      String
  assignedTo     String?
  resolutionNote String?              @db.Text
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  actions        ModerationAction[]

  @@index([targetType, targetId])
  @@index([status, createdAt(sort: Desc)])
}

model ModerationAction {
  id               String               @id @default(cuid())
  moderationCaseId String
  actionType       ModerationActionType
  actorId          String
  note             String?              @db.Text
  createdAt        DateTime             @default(now())
  moderationCase   ModerationCase       @relation(fields: [moderationCaseId], references: [id], onDelete: Cascade)

  @@index([moderationCaseId, createdAt(sort: Desc)])
}

model BlockedUser {
  id          String   @id @default(cuid())
  userId      String   @unique
  reason      String   @db.Text
  blockedBy   String
  blockedAt   DateTime @default(now())
  unblockedAt DateTime?
}

model ContentFlag {
  id         String               @id @default(cuid())
  targetType ModerationTargetType
  targetId   String
  reason     String               @db.Text
  status     ContentFlagStatus    @default(active)
  createdBy  String
  hiddenBy   String?
  hiddenAt   DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([targetType, targetId])
  @@index([status, createdAt(sort: Desc)])
}

model Notification {
  id            String                    @id @default(cuid())
  userId        String
  type          NotificationType
  title         String
  body          String                    @db.Text
  referenceType NotificationReferenceType
  referenceId   String
  dedupeKey     String?                   @unique
  isRead        Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  readAt        DateTime?
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc)])
}
