NODE_ENV=development
PORT=4040
SERVER_URL=http://localhost:4040
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres123@localhost:54320/mollmart?schema=public
POSTGRES_PORT=54320
POSTGRES_DB=mollmart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

JWT_ACCESS_SECRET=change-me-shared-access-secret
JWT_REFRESH_SECRET=change-me-shared-refresh-secret
ACCESS_TOKEN_EXPIRE=20m
REFRESH_TOKEN_EXPIRE=1d
REFRESH_TOKEN_COOKIE_NAME=jid
INTERNAL_API_TOKEN=

REDIS_URL=redis://localhost:6380
REDIS_PORT=6380
REDIS_ENABLED=true

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
ALLOW_MULTIPLE_ACTIVE_OFFERS_PER_REQUEST=false
SUBSCRIBE_MODERATION_EVENTS=true
# auto: dev always requires email verify (Ethereal test inbox); prod requires verify only when SMTP is not the placeholder defaults
REQUIRE_EMAIL_VERIFICATION=auto

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=password
EMAIL_FROM=no-reply@example.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Cloudflare R2 (S3 API) for catalog images — set all five or leave all empty to use local uploads/catalog
# R2_ENDPOINT must be the account endpoint only, e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com (no /bucket)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for objects (custom domain or R2 public URL), no trailing slash, e.g. https://cdn.example.com
R2_PUBLIC_BASE_URL=
