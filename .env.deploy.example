POSTGRES_DB=mollmart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=54320

JWT_ACCESS_SECRET=change-this-long-access-secret
JWT_REFRESH_SECRET=change-this-long-refresh-secret
ACCESS_TOKEN_EXPIRE=20m
REFRESH_TOKEN_EXPIRE=1d
REFRESH_TOKEN_COOKIE_NAME=jid

SERVER_URL=https://mollmart-backend.onrender.com
CORS_ORIGIN=https://mollmart-owcb.vercel.app,https://mollmart.vercel.app
NEXT_PUBLIC_API_URL=https://mollmart-backend.onrender.com

REDIS_PORT=6380
REDIS_ENABLED=true

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
ALLOW_MULTIPLE_ACTIVE_OFFERS_PER_REQUEST=false
SUBSCRIBE_MODERATION_EVENTS=true
REQUIRE_EMAIL_VERIFICATION=auto

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=password
EMAIL_FROM=no-reply@example.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
