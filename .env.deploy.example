POSTGRES_DB=mollmart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=54320

NODE_ENV=production
JWT_ACCESS_SECRET=change-this-long-access-secret
JWT_REFRESH_SECRET=change-this-long-refresh-secret
ACCESS_TOKEN_EXPIRE=20m
REFRESH_TOKEN_EXPIRE=1d
REFRESH_TOKEN_COOKIE_NAME=jid

SERVER_URL=https://mollmart.onrender.com
CORS_ORIGINS=https://mollmart-azure.vercel.app
NEXT_PUBLIC_API_URL=https://mollmart.onrender.com

REDIS_PORT=6380
REDIS_ENABLED=true

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
ALLOW_MULTIPLE_ACTIVE_OFFERS_PER_REQUEST=false
SUBSCRIBE_MODERATION_EVENTS=true

GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_USER_ID=me
EMAIL_FROM=no-reply@example.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

FRONTEND_URL=https://mollmart-azure.vercel.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_CURRENCIES=USD,EUR,KZT

R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
